# Server-only. Supabase transaction pooler (port 6543) is suitable for runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Supabase direct connection or session pooler (port 5432) for migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
APP_URL=http://localhost:3000
# Generate with npm run host:password. Never use a NEXT_PUBLIC_ prefix.
HOST_PASSWORD_HASH=
# Optional trusted scheduled reconciliation endpoint; use >=32 random characters.
CRON_SECRET=
